{
  "configurations": [
    {
      "name": "Android NDK",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/app/src/main/cpp",
        "C:/MyApps/dev/vcpkg-master/vcpkg-master/installed/x64-windows/include",   // Add this!
        "${env:ANDROID_NDK_HOME}/sources/android/native_app_glue",
        "${env:ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include",
        "${env:ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include/android",
        "${env:ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include/arm-linux-androideabi"
      ],
      "defines": [],
      "compilerPath": "${env:ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/windows-x86_64/bin/clang++.exe",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-clang-x64"
    }
  ],
  "version": 4
}
